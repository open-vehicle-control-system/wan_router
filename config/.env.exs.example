import Config

# Template for config/.env.exs (gitignored), which holds the secrets of the
# firmware build:
#
#     cp config/.env.exs.example config/.env.exs
#
# WIFI_AP_SSID and WIFI_AP_PSK are the SSID and the WPA2 passphrase (8 to 63
# characters) of the wlan0 access point.
System.put_env("WIFI_AP_SSID", "change-me")
System.put_env("WIFI_AP_PSK", "change-me-too")
